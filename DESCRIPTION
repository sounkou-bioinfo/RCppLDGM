Package: RcppLDGM
Title: Rcpp Port of Linkage Disequilibrium Graphical Models
Version: 0.0.0.9000
Authors@R: c(
    person("Sounkou", "Toure", email = "sounkoutoure@gmail.com", role = c("aut", "cre")),
    person("Anthony Wilder", "Wohns", role = "cph"),
    person("Luke", "O'Connor", role = "cph"),
